{
  "displayName": "Oszczędzify: inflation import failure",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Scheduled import error or timeout",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" resource.labels.service_name=\"syncinflation\" severity>=ERROR"
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": { "period": "3600s" },
    "autoClose": "604800s"
  },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Check inflationImportStatus and Cloud Run logs. Failed imports preserve the last approved inflation dataset. Use docs/INFLACJA-WDROZENIE.md for dry-run, source review and rollback."
  }
}
