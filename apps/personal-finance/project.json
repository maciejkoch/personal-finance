{
  "name": "personal-finance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pf",
  "sourceRoot": "apps/personal-finance/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/personal-finance",
        "index": "apps/personal-finance/src/index.html",
        "browser": "apps/personal-finance/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/personal-finance/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/personal-finance/public"
          },
          {
            "glob": "version.json",
            "input": ".build-metadata/production",
            "output": "/"
          }
        ],
        "styles": [
          "apps/personal-finance/src/styles.scss",
          "libs/ui/src/styles.scss"
        ],
        "scripts": [],
        "server": "apps/personal-finance/src/main.server.ts",
        "prerender": {
          "discoverRoutes": false,
          "routesFile": "apps/personal-finance/routes.txt"
        },
        "ssr": false
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/personal-finance/src/environments/environment.ts",
              "with": "apps/personal-finance/src/environments/environment.local.ts"
            }
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/personal-finance/public"
            },
            {
              "glob": "version.json",
              "input": ".build-metadata/local",
              "output": "/"
            }
          ]
        },
        "development-production-api": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/personal-finance/public"
            },
            {
              "glob": "version.json",
              "input": ".build-metadata/production",
              "output": "/"
            }
          ]
        },
        "staging": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/personal-finance/src/environments/environment.ts",
              "with": "apps/personal-finance/src/environments/environment.staging.local.ts"
            }
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/personal-finance/public"
            },
            {
              "glob": "version.json",
              "input": ".build-metadata/staging",
              "output": "/"
            }
          ]
        },
        "development-staging": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/personal-finance/src/environments/environment.ts",
              "with": "apps/personal-finance/src/environments/environment.staging.local.ts"
            }
          ],
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/personal-finance/public"
            },
            {
              "glob": "version.json",
              "input": ".build-metadata/staging",
              "output": "/"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "personal-finance:build:production"
        },
        "development": {
          "buildTarget": "personal-finance:build:development"
        },
        "production-api": {
          "buildTarget": "personal-finance:build:development-production-api"
        },
        "staging": {
          "buildTarget": "personal-finance:build:development-staging"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "personal-finance:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/personal-finance/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "personal-finance:build",
        "staticFilePath": "dist/apps/personal-finance/browser",
        "spa": true
      }
    }
  }
}
