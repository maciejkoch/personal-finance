    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "chart.js": "4.6.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.5",
    "angular-eslint": "22.6.0",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
