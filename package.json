  "scripts": {
    "brand:generate": "node scripts/generate-brand.mjs",
    "start": "node scripts/workspace.mjs serve local",
    "build": "node scripts/workspace.mjs build production",
    "deploy": "npm run build && npx -y firebase-tools@15.34.1 deploy --only hosting --project personal-finance-2ee61",
    "start:production": "node scripts/workspace.mjs serve production",
    "start:staging": "node scripts/workspace.mjs serve staging",
    "build:local": "node scripts/workspace.mjs build local",
    "build:staging": "node scripts/workspace.mjs build staging",
    "test": "ng test --watch=false",
    "test:functions": "npm --prefix functions test",
    "build:functions": "npm --prefix functions run build && node scripts/write-version.mjs functions",
    "emulators": "npm run build:functions && npx -y firebase-tools@15.34.1 emulators:start --only functions,hosting --project personal-finance-2ee61",
    "smoke:api": "node scripts/smoke-api.mjs",
    "deploy:functions": "npx -y firebase-tools@15.34.1 deploy --only functions --project personal-finance-2ee61",
    "smoke:bonds": "node scripts/smoke-bonds.mjs",
    "smoke:hosting": "node scripts/smoke-hosting.mjs",
    "preview:prepare": "node scripts/prepare-hosting-preview.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:functions": "npm --prefix functions run lint",
    "check:content": "node scripts/check-content.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
