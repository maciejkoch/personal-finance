{
  "hosting": {
    "public": "dist/oszczedzify/browser",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*-????????.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*-????????.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/calculators/treasury-bonds",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      },
      {
        "source": "/calculators/treasury-bonds/",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      },
      {
        "source": "/calculators/regular-contribution",
        "destination": "/kalkulatory/regularne-oszczedzanie",
        "type": 301
      },
      {
        "source": "/calculators/regular-contribution/",
        "destination": "/kalkulatory/regularne-oszczedzanie",
        "type": 301
      },
      {
        "source": "/calculators/long-term-savings",
        "destination": "/kalkulatory/oszczedzanie-na-cel",
        "type": 301
      },
      {
        "source": "/calculators/long-term-savings/",
        "destination": "/kalkulatory/oszczedzanie-na-cel",
        "type": 301
      },
      {
        "source": "/about-us",
        "destination": "/o-nas",
        "type": 301
      },
      {
        "source": "/about-us/",
        "destination": "/o-nas",
        "type": 301
      },
      {
        "source": "/calculators",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      },
      {
        "source": "/calculators/",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      },
      {
        "source": "/kalkulatory",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      },
      {
        "source": "/kalkulatory/",
        "destination": "/kalkulatory/obligacje-skarbowe",
        "type": 301
      }
    ],
    "trailingSlash": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build",
        "node \"$PROJECT_DIR/scripts/write-version.mjs\" functions"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5050
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true,
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "europe-central2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
