{
  "compilerOptions": {
    "module": "nodenext",
    "rootDir": "src",
    "types": ["node", "mocha"],
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "resolveJsonModule": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
