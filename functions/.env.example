BOND_DATABASE_ID=(default)
BOND_SOURCE_BUCKET=personal-finance-2ee61-bond-sources
# Enable only after seed, IAM and alert policy are verified.
BOND_IMPORT_ENABLED=false
# Roll out off -> monitor -> enforce after deploying the configured web client.
APP_CHECK_MODE=off
# Optional comma-separated Firebase web app IDs; empty accepts apps in this project.
APP_CHECK_APP_IDS=

# Same database as bonds. Optional bucket override; otherwise use BOND_SOURCE_BUCKET.
INFLATION_IMPORT_ENABLED=false
INFLATION_SOURCE_BUCKET=
